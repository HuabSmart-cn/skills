        {
          "id": 3,
          "type": 0,
          "name": "六三",
          "scripture": "勿用取女，见金夫，不有躬，无攸利。"
        },
        {
          "id": 4,
          "type": 0,
          "name": "六四",
          "scripture": "困蒙，吝。"
        },
        {
          "id": 5,
          "type": 0,
          "name": "六五",
          "scripture": "童蒙，吉。"
        },
        {
          "id": 6,
          "type": 1,
          "name": "上九",
          "scripture": "击蒙；不利为寇，利御寇。"
        }
      ]
