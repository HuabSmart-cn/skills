        },
        {
          "id": 4,
          "type": 0,
          "name": "六四",
          "scripture": "乘马班如，求婚媾，往吉，无不利。"
        },
        {
          "id": 5,
          "type": 1,
          "name": "九五",
          "scripture": "屯其膏，小贞吉，大贞凶。"
