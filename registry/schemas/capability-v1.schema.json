{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huabsmart.cn/schemas/capability-registry/capability/v1.json",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "identity", "summary", "artifact", "origin", "dependencies", "runtime", "permissions", "contracts", "failurePolicy", "lifecycle", "verification"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^cap\\.(skill|agent|prompt|mcp|plugin|workflow|knowledge)\\.[a-z0-9.-]+\\.v[0-9]+$" },
    "kind": { "enum": ["skill", "agent", "prompt", "mcp", "plugin", "workflow", "knowledge"] },
    "identity": { "$ref": "#/$defs/identity" },
    "summary": { "$ref": "#/$defs/localized" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "origin": { "$ref": "#/$defs/origin" },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "contracts": { "$ref": "#/$defs/contracts" },
    "failurePolicy": { "$ref": "#/$defs/failurePolicy" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "verification": { "$ref": "#/$defs/verification" }
  },
  "additionalProperties": false,
  "$defs": {
    "localized": { "type": "object", "required": ["zh", "en"], "properties": { "zh": { "type": "string" }, "en": { "type": "string" } }, "additionalProperties": false },
    "identity": { "type": "object", "required": ["canonicalName", "aliases", "displayName"], "properties": { "canonicalName": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "displayName": { "$ref": "#/$defs/localized" } }, "additionalProperties": false },
    "artifact": { "type": "object", "required": ["root", "entry", "contentLayer"], "properties": { "legacyAssetId": { "type": "string" }, "root": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" }, "entry": { "type": "string", "pattern": "^[^/\\\\]+$" }, "contentLayer": { "enum": ["source", "huabsmart-metadata"] } }, "additionalProperties": false },
    "origin": { "type": "object", "required": ["sourceType", "license", "metadataAuthority"], "properties": { "sourceType": { "enum": ["local-capture", "github", "remote", "remote-bundle", "manual"] }, "originalPath": { "type": "string" }, "license": { "type": "object", "required": ["status"], "properties": { "spdx": { "type": "string" }, "status": { "enum": ["verified", "declared", "unknown", "unverified"] } }, "additionalProperties": false }, "metadataAuthority": { "const": "huabsmart" } }, "additionalProperties": false },
    "dependency": { "type": "object", "required": ["id", "reason"], "properties": { "id": { "type": "string", "pattern": "^cap\\.(skill|agent|prompt|mcp|plugin|workflow|knowledge)\\.[a-z0-9.-]+\\.v[0-9]+$" }, "reason": { "type": "string", "minLength": 1 }, "version": { "type": "string" } }, "additionalProperties": false },
    "dependencies": { "type": "object", "required": ["required", "optional"], "properties": { "required": { "type": "array", "items": { "$ref": "#/$defs/dependency" } }, "optional": { "type": "array", "items": { "$ref": "#/$defs/dependency" } } }, "additionalProperties": false },
    "runtime": { "type": "object", "required": ["hosts", "tools", "environment", "externalServices"], "properties": { "hosts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["runtime", "compatibility"], "properties": { "runtime": { "enum": ["codex", "claude-code", "dsh", "openclaw", "other"] }, "compatibility": { "enum": ["supported", "adaptable", "unsupported", "unverified"] } }, "additionalProperties": false } }, "tools": { "type": "array", "items": { "type": "object", "required": ["name", "required"], "properties": { "name": { "type": "string" }, "required": { "type": "boolean" } }, "additionalProperties": false } }, "environment": { "type": "array", "items": { "type": "object", "required": ["name", "required"], "properties": { "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "required": { "type": "boolean" }, "secret": { "type": "boolean" } }, "additionalProperties": false } }, "externalServices": { "type": "array", "items": { "type": "object", "required": ["name", "required", "network"], "properties": { "name": { "type": "string" }, "required": { "type": "boolean" }, "network": { "type": "boolean" } }, "additionalProperties": false } } }, "additionalProperties": false },
    "permissions": { "type": "object", "required": ["operations", "risk"], "properties": { "operations": { "type": "array", "uniqueItems": true, "items": { "enum": ["read", "create", "update", "delete", "auth", "external_write", "publish", "execute", "search"] } }, "risk": { "enum": ["low", "medium", "high", "critical"] } }, "additionalProperties": false },
    "contracts": { "type": "object", "required": ["input", "output"], "properties": { "input": { "type": "string" }, "output": { "type": "string" } }, "additionalProperties": false },
    "failurePolicy": { "type": "object", "required": ["mode", "mustReturn"], "properties": { "mode": { "enum": ["must_execute", "no_fallback", "llm_fallback_allowed"] }, "mustReturn": { "type": "array", "minItems": 1, "items": { "enum": ["dependency_missing", "runtime_unsupported", "authorization_denied", "execution_failed"] } } }, "additionalProperties": false },
    "lifecycle": { "type": "object", "required": ["state"], "properties": { "state": { "enum": ["active", "deprecated", "archived", "abandoned"] } }, "additionalProperties": false },
    "verification": { "type": "object", "required": ["status", "receipts"], "properties": { "status": { "enum": ["unverified", "verified", "failed", "blocked"] }, "receipts": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": false }
  }
}
